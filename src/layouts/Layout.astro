---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "The cutest personal website.",
	image = "/opengraph_image.jpg",
} = Astro.props;

const pageTitle = title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://cdn.discordapp.com" />
		<link rel="preconnect" href="https://avatars.githubusercontent.com" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta name="theme-color" content="#FF00FF" />
		<ClientRouter />
		<script
			id="discord:component-embed"
			type="application/json"
			set:html={JSON.stringify({
				component: {
					type: 17,
					spoiler: false,
					accent_color: 0xff00ff,
					components: [
						{
							type: 9,
							components: [
								{
									type: 10,
									content: `# **${pageTitle}**\n${description}`,
								},
							],
							accessory: {
								type: 2,
								style: 5,
								url: canonicalURL.href,
								label: "Open",
							},
						},
						{
							type: 12,
							items: [
								{
									media: {
										url: socialImage.href,
									},
									description: pageTitle,
								},
							],
						},
						{
							type: 14,
							spacing: 1,
						},
						{
							type: 1,
							components: [
								{
									type: 2,
									style: 5,
									url: new URL("/", Astro.site).href,
									label: "Home",
								},
								{
									type: 2,
									style: 5,
									url: new URL("/projects/", Astro.site).href,
									label: "Projects",
								},
								{
									type: 2,
									style: 5,
									url: new URL("/blog/", Astro.site).href,
									label: "Blog",
								},
							],
						},
					],
				},
			})}
		/>
	</head>
	<body class="bg-background text-foreground flex min-h-screen flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
