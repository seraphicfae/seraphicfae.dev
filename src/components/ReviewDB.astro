---
import { Icon } from "astro-icon/components";

interface ReviewSender {
	username: string;
	profilePhoto: string;
}

interface Review {
	sender: ReviewSender;
	timestamp: number;
	comment: string;
	score: number | null;
}

interface ReviewApiResponse {
	reviews: Review[];
}

const DISCORD_ID = "1009098164864823441";
const reviewsPerPage = 5;

let reviews: Review[] = [];
try {
	const response = await fetch(
		`https://manti.vendicated.dev/api/reviewdb/users/${DISCORD_ID}/reviews?flags=2`,
	);
	const data = (await response.json()) as ReviewApiResponse;
	reviews = data.reviews ?? [];
} catch (error) {
	console.error("mantikafasi pls fix:", error);
	reviews = [];
}

const totalPageCount = Math.ceil(reviews.length / reviewsPerPage);
---

<section id="reviewdb-section" class="flex flex-col gap-3">
	<div class="flex items-center gap-2">
		<Icon name="simple-icons:discord" class="size-4 shrink-0" />
		<h2 class="font-black tracking-widest uppercase">reviewdb</h2>
	</div>
	{
		reviews.length === 0 ? (
			<p class="text-muted text-sm">Nothing to see here</p>
		) : (
			<div class="flex flex-col gap-3">
				{Array.from({ length: totalPageCount }).map((_, pageIndex) => (
					<div
						class={`review-page flex flex-col gap-3 ${pageIndex === 0 ? "" : "hidden"}`}
						data-page-index={pageIndex}
					>
						{reviews
							.slice(
								pageIndex * reviewsPerPage,
								pageIndex * reviewsPerPage + reviewsPerPage,
							)
							.map((review) => (
								<div class="flex items-start gap-3">
									<img
										src={review.sender.profilePhoto}
										alt={review.sender.username}
										width={40}
										height={40}
										loading="eager"
										decoding="async"
										class="h-12 w-12 shrink-0 rounded-lg object-cover"
									/>
									<div class="min-w-0 flex-1">
										<div class="flex items-baseline gap-2">
											<h class="text-secondary text-xs font-medium">
												{review.sender.username}
											</h>
											<span class="text-muted text-xs">
												{new Date(review.timestamp * 1000).toLocaleDateString()}
											</span>
										</div>
										<p class="text-sm wrap-break-word">{review.comment}</p>
									</div>
									{review.score != null && (
										<div class="text-subtle flex w-6 shrink-0 flex-col items-center gap-0.5 pt-0.5">
											<Icon name="lucide:chevron-up" class="size-3.5" />
											<span class="text-xs font-medium">{review.score}</span>
											<Icon name="lucide:chevron-down" class="size-3.5" />
										</div>
									)}
								</div>
							))}
					</div>
				))}
				<div class="flex items-center justify-between pt-1">
					<button
						id="previous-button"
						type="button"
						disabled
						class="text-muted hover:text-foreground-hover cursor-pointer text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40"
					>
						Previous
					</button>
					<span id="page-indicator" class="text-muted text-xs">
						Page 1 of {totalPageCount}
					</span>
					<button
						id="next-button"
						type="button"
						disabled={totalPageCount <= 1}
						class="text-muted hover:text-foreground-hover cursor-pointer text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40"
					>
						Next
					</button>
				</div>
			</div>
		)
	}
</section>

<script>
	function pagination() {
		const reviewSection = document.getElementById("reviewdb-section");
		const previousButton = document.getElementById(
			"previous-button",
		) as HTMLButtonElement | null;
		const nextButton = document.getElementById(
			"next-button",
		) as HTMLButtonElement | null;
		const pageIndicator = document.getElementById("page-indicator");

		if (reviewSection && previousButton && nextButton && pageIndicator) {
			const prevBtn = previousButton;
			const nextBtn = nextButton;
			const indicator = pageIndicator;
			const pages = reviewSection.querySelectorAll<HTMLElement>(".review-page");
			const totalPageCount = pages.length;
			let currentPageIndex = 0;

			function goToPage(delta: number): void {
				currentPageIndex = Math.min(
					Math.max(currentPageIndex + delta, 0),
					totalPageCount - 1,
				);

				pages.forEach((page, i) =>
					page.classList.toggle("hidden", i !== currentPageIndex),
				);
				indicator.textContent = `Page ${currentPageIndex + 1} of ${totalPageCount}`;
				prevBtn.disabled = currentPageIndex === 0;
				nextBtn.disabled = currentPageIndex === totalPageCount - 1;
			}

			prevBtn.addEventListener("click", () => goToPage(-1));
			nextBtn.addEventListener("click", () => goToPage(1));
		}
	}
	document.addEventListener("astro:page-load", pagination);
	pagination();
</script>
