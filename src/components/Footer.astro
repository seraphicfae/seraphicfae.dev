---
import { Icon } from "astro-icon/components";
---

<footer class="mt-auto flex justify-center px-6 py-6">
	<div
		class="border-border bg-background text-secondary flex items-center gap-6 rounded-full border px-6 py-3 text-sm"
	>
		<a
			href="https://www.oracle.com/erp/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="heart"
			class="flex items-center justify-center gap-2"
		>
			Psst, you're cute
			<Icon name="lucide:heart" class="text-accent-secondary" />
		</a>

		<span class="bg-divider h-3 w-px"></span>

		<a
			href="https://github.com/seraphicfae/seraphicfae.dev"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
			class="hover:text-foreground transition-colors"
		>
			<Icon name="simple-icons:github" class="h-4 w-4" />
		</a>
	</div>
</footer>
