---
import { Icon } from "astro-icon/components";

const nav = [
	{
		label: "/home/meimei",
		ariaLabel: "Home",
		href: "/",
		icon: "lucide:house",
	},
	{
		label: "/bin/projects",
		ariaLabel: "Projects",
		href: "/projects",
		icon: "lucide:git-branch",
	},
	{
		label: "/var/blog",
		ariaLabel: "Blog",
		href: "/blog",
		icon: "lucide:notebook",
	},
];

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
	href === "/" ? pathname === href : pathname.startsWith(href);
---

<header class="mt-auto flex justify-center px-6 py-6">
	<div
		class="border-border/70 bg-background/80 text-secondary flex items-center gap-6 rounded-full border px-6 py-3 text-sm shadow-lg backdrop-blur-xl"
	>
		<img src="/favicon.svg" alt="favicon svg" class="block h-7 w-7" />
		<nav class="flex items-center gap-1">
			{
				nav.map(({ label, ariaLabel, href, icon }) => (
					<a
						href={href}
						aria-label={ariaLabel}
						aria-current={isCurrent(href) ? "page" : undefined}
						class:list={[
							"relative flex items-center gap-1.5 px-3 py-1.5 text-sm transition-colors duration-200",
							"after:absolute after:right-3 after:bottom-0 after:left-3 after:h-0.5 after:rounded-full after:bg-current",
							"after:origin-center after:transition-transform after:duration-300",
							isCurrent(href)
								? "text-foreground after:bg-accent after:scale-x-100"
								: "text-muted hover:text-foreground after:scale-x-0 hover:after:scale-x-100",
						]}
					>
						{icon && <Icon name={icon} class="size-4" />}
						<span class="text-s hidden sm:block">{label}</span>
					</a>
				))
			}
		</nav>
	</div>
</header>
